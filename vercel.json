{
  "version": 2,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/cron/overdue-rent",     "schedule": "0 16 * * *" },
    { "path": "/cron/stale-workorders", "schedule": "0 17 * * *" },
    { "path": "/cron/weekly-report",    "schedule": "0 1 * * 6"  }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  }
}
