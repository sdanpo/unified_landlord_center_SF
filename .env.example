# ─── ERPNext / PropMS ────────────────────────────────
# Base URL of your ERPNext instance (no trailing slash)
ERPNEXT_BASE_URL=https://erpnext.yourdomain.com
# ERPNext API key + secret — generate in ERPNext → User → API Access
ERPNEXT_API_KEY=your_erpnext_api_key
ERPNEXT_API_SECRET=your_erpnext_api_secret

# ─── OpenAI ──────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ─── Telegram Bot ────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Comma-separated Telegram user IDs allowed to use the bot (landlord/managers only)
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# ─── Webhook Server ──────────────────────────────────
WEBHOOK_PORT=3000
# Shared secret used to validate incoming ERPNext webhook signatures.
# Set the same value in ERPNext → Integrations → Webhooks → Secret.
WEBHOOK_SECRET=your_webhook_shared_secret
# Publicly reachable URL of this server (behind a reverse proxy / ngrok in dev)
WEBHOOK_BASE_URL=https://your-server.example.com

# ─── SMS – Twilio (required) ──────────────────────────
# ERPNext has no outbound SMS API; Twilio handles all tenant text messages.
# Sign up at https://twilio.com, buy a number, and fill in the values below.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15550001234

# ─── Reports ─────────────────────────────────────────
# Where to deliver weekly reports: "telegram" | "email" | "gdrive"
REPORT_DELIVERY=telegram
REPORT_GOOGLE_DRIVE_FOLDER_ID=
REPORT_EMAIL_TO=landlord@example.com

# ─── Logging ─────────────────────────────────────────
LOG_LEVEL=info
