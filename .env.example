# ─── ERPNext / PropMS ────────────────────────────────
# Base URL of your ERPNext instance (no trailing slash)
ERPNEXT_BASE_URL=https://erpnext.yourdomain.com
# ERPNext API key + secret — generate in ERPNext → User → API Access
ERPNEXT_API_KEY=your_erpnext_api_key
ERPNEXT_API_SECRET=your_erpnext_api_secret

# ─── OpenAI ──────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ─── Telegram Bot ────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Comma-separated Telegram user IDs allowed to use the bot (landlord/managers only)
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# ─── Webhook Server ──────────────────────────────────
WEBHOOK_PORT=3000
# Shared secret used to validate incoming ERPNext webhook signatures.
# Set the same value in ERPNext → Integrations → Webhooks → Secret.
WEBHOOK_SECRET=your_webhook_shared_secret
# Publicly reachable URL of this server (behind a reverse proxy / ngrok in dev)
WEBHOOK_BASE_URL=https://your-server.example.com

# ─── Tenant Portal – Stripe Payments ────────────────
# Enables the "Pay Now" button on rent invoices in the tenant portal.
# Get keys at https://dashboard.stripe.com/apikeys
# Leave blank to install Stripe Settings without activating payment collection.
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
# GL account to credit when Stripe payments are received (instance-specific).
# Find it in ERPNext → Chart of Accounts.  Default works for standard installs.
STRIPE_PAYMENT_ACCOUNT=Debtors - LC

# ─── SMS – Twilio (required) ──────────────────────────
# ERPNext has no outbound SMS API; Twilio handles all tenant text messages.
# Sign up at https://twilio.com, buy a number, and fill in the values below.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15550001234

# ─── Hemlane Replacement: BoldSign (lease e-signatures) ──────
# BoldSign is used for e-signatures ($5–99/mo, free tier available).
# 1. Create account at https://app.boldsign.com
# 2. Upload your lease PDF as a template with signer roles: Tenant (index 1), Landlord (index 2)
# 3. Copy the Template ID below
# 4. Generate an API key at app.boldsign.com → API Management
# 5. Create a webhook at app.boldsign.com → API Management → Webhooks
#    pointing to: https://your-server.example.com/webhooks/boldsign/completed
#    Copy the webhook signing secret below.
BOLDSIGN_API_KEY=your_boldsign_api_key
BOLDSIGN_TEMPLATE_ID=your_boldsign_template_id
BOLDSIGN_WEBHOOK_SECRET=your_boldsign_webhook_signing_secret
# Landlord details used as counter-signer on every lease.
LANDLORD_EMAIL=landlord@example.com
LANDLORD_NAME=Your Name

# ─── Hemlane Replacement: TransUnion SmartMove (tenant screening) ─
# Create a landlord account at https://www.mysmartmove.com
# and generate an API key under Developer Settings.
SMARTMOVE_API_KEY=your_smartmove_api_key

# ─── Late Fee Auto-Charging ───────────────────────────
# Set to "1" to automatically submit late fee invoices (immediately visible on tenant portal).
# Leave as "0" (default) to create them as drafts for accountant review before submission.
LATE_FEE_AUTO_SUBMIT=0

# ─── Reports ─────────────────────────────────────────
# Where to deliver weekly reports: "telegram" | "email" | "gdrive"
REPORT_DELIVERY=telegram
REPORT_GOOGLE_DRIVE_FOLDER_ID=
REPORT_EMAIL_TO=landlord@example.com

# ─── Logging ─────────────────────────────────────────
LOG_LEVEL=info
