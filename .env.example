# ─────────────────────────────────────────────
# Core PMS Selection: "doorloop" | "buildium"
# ─────────────────────────────────────────────
PMS_PROVIDER=doorloop

# ─── DoorLoop API ───────────────────────────
DOORLOOP_API_KEY=your_doorloop_api_key_here
DOORLOOP_BASE_URL=https://api.doorloop.com/v1

# ─── Buildium API (alternative) ─────────────
BUILDIUM_CLIENT_ID=your_buildium_client_id
BUILDIUM_CLIENT_SECRET=your_buildium_client_secret
BUILDIUM_BASE_URL=https://api.buildium.com/v1

# ─── OpenAI ─────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ─── Telegram Bot ───────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Comma-separated Telegram user IDs allowed to use the bot (landlord/managers only)
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# ─── Webhook Server ──────────────────────────
WEBHOOK_PORT=3000
# Secret used to validate incoming webhook signatures from PMS
WEBHOOK_SECRET=your_webhook_shared_secret
# Publicly reachable URL for this server (ngrok / production domain)
WEBHOOK_BASE_URL=https://your-server.example.com

# ─── SMS (Twilio – optional; falls back to PMS native SMS) ──
USE_TWILIO=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15550001234

# ─── Reports ─────────────────────────────────
# Where to deliver weekly reports: "telegram" | "email" | "gdrive"
REPORT_DELIVERY=telegram
REPORT_GOOGLE_DRIVE_FOLDER_ID=
REPORT_EMAIL_TO=landlord@example.com

# ─── Logging ─────────────────────────────────
LOG_LEVEL=info
