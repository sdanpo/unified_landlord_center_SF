{
  "name": "unified-landlord-center-sf",
  "version": "1.0.0",
  "description": "AI-Augmented Property Management Assistant – Telegram NLP agent for landlords powered by ERPNext + OpenAI",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.js' 'tests/**/*.js'",
    "setup:erpnext": "node scripts/setup-erpnext-fields.js",
    "setup:scripts": "node scripts/run-erpnext-setup.js"
  },
  "keywords": [
    "property-management",
    "telegram-bot",
    "openai",
    "erpnext",
    "frappe",
    "propms",
    "nlp"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "https-proxy-agent": "^5.0.1",
    "node-telegram-bot-api": "^0.66.0",
    "openai": "^4.52.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "eslint": "^9.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
