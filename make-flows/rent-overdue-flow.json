{
  "name": "Rent Overdue – Tenant SMS + Landlord Telegram Alert",
  "flow": [
    {
      "id": 1,
      "module": "webhook:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": 1,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "hook": {
              "data": { "editable": "true" },
              "label": "ERPNext invoice-overdue"
            }
          }
        },
        "parameters": [
          { "name": "hook", "type": "hook:custom-webhook", "label": "Webhook", "required": true },
          { "name": "maxResults", "type": "number", "label": "Maximum number of results" }
        ]
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": false, "useNewZLibDecompression": true },
      "mapper": {
        "url": "YOUR_ERPNEXT_BASE_URL/api/resource/Customer/{{1.customer}}",
        "serializeUrl": false,
        "method": "get",
        "headers": [
          { "key": "Authorization", "value": "token YOUR_ERPNEXT_API_KEY:YOUR_ERPNEXT_API_SECRET" },
          { "key": "Accept", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "",
        "parseResponse": true
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "restore": { "expect": { "method": { "label": "GET" } } }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": { "designer": { "x": 600, "y": 0 } },
      "routes": [
        {
          "label": "Phone available – send SMS + Telegram",
          "filter": {
            "name": "Has mobile_no",
            "conditions": [
              [ { "a": "{{2.data.mobile_no}}", "b": "", "o": "exist" } ]
            ]
          },
          "flow": [
            {
              "id": 4,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": false, "useNewZLibDecompression": true },
              "mapper": {
                "url": "https://api.twilio.com/2010-04-01/Accounts/YOUR_TWILIO_ACCOUNT_SID/Messages.json",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
                ],
                "qs": [],
                "bodyType": "url_encoded_form",
                "body": [
                  { "key": "To",   "value": "{{2.data.mobile_no}}" },
                  { "key": "From", "value": "YOUR_TWILIO_FROM_NUMBER" },
                  { "key": "Body", "value": "This is an automated alert from Management. Your rent balance of ${{1.outstanding_amount}} for {{1.custom_unit}} at {{1.custom_property}} is currently past due. Please remit payment via your tenant portal at your earliest convenience." }
                ],
                "authUser": "YOUR_TWILIO_ACCOUNT_SID",
                "authPass": "YOUR_TWILIO_AUTH_TOKEN",
                "parseResponse": true
              },
              "metadata": {
                "designer": { "x": 900, "y": -150 },
                "restore": { "expect": { "method": { "label": "POST" } } }
              }
            },
            {
              "id": 5,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": false, "useNewZLibDecompression": true },
              "mapper": {
                "url": "https://api.telegram.org/botYOUR_TELEGRAM_BOT_TOKEN/sendMessage",
                "serializeUrl": false,
                "method": "post",
                "headers": [ { "key": "Content-Type", "value": "application/json" } ],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "body": "{\"chat_id\":\"YOUR_TELEGRAM_LANDLORD_CHAT_ID\",\"parse_mode\":\"Markdown\",\"text\":\"🚨 *Rent Overdue Alert*\\n\\nTenant: {{1.customer_name}} (Unit {{1.custom_unit}})\\nAmount Due: ${{1.outstanding_amount}}\\nDue Date: {{1.due_date}}\\nProperty: {{1.custom_property}}\\nInvoice: {{1.name}}\\n\\nAn automated SMS reminder has been dispatched to the tenant.\"}",
                "parseResponse": true
              },
              "metadata": {
                "designer": { "x": 1200, "y": -150 },
                "restore": { "expect": { "method": { "label": "POST" } } }
              }
            }
          ]
        },
        {
          "label": "No phone – Telegram alert only",
          "flow": [
            {
              "id": 6,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": false, "useNewZLibDecompression": true },
              "mapper": {
                "url": "https://api.telegram.org/botYOUR_TELEGRAM_BOT_TOKEN/sendMessage",
                "serializeUrl": false,
                "method": "post",
                "headers": [ { "key": "Content-Type", "value": "application/json" } ],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "body": "{\"chat_id\":\"YOUR_TELEGRAM_LANDLORD_CHAT_ID\",\"parse_mode\":\"Markdown\",\"text\":\"🚨 *Rent Overdue Alert*\\n\\nTenant: {{1.customer_name}} (Unit {{1.custom_unit}})\\nAmount Due: ${{1.outstanding_amount}}\\nDue Date: {{1.due_date}}\\nProperty: {{1.custom_property}}\\nInvoice: {{1.name}}\\n\\n⚠️ No phone number on file – SMS was not sent.\"}",
                "parseResponse": true
              },
              "metadata": {
                "designer": { "x": 900, "y": 150 },
                "restore": { "expect": { "method": { "label": "POST" } } }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com"
  }
}
