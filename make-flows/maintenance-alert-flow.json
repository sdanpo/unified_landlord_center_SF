{
  "_meta": {
    "title": "Stale Maintenance Ticket – Proactive Landlord Alert",
    "description": "Runs daily at 9:00 AM. Queries ERPNext for all HD Tickets (Maintenance Requests) that have been in Open or Replied status for more than 48 hours. Sends a consolidated Telegram alert to the landlord listing every stale ticket.",
    "version": "2.0.0",
    "platform": "Make.com (formerly Integromat)",
    "tier_required": "Pro ($16/month)",
    "estimated_operations_per_run": 3,
    "pms": "ERPNext (PropMS)"
  },

  "scenario": {
    "name": "Stale Maintenance Ticket – Daily Proactive Alert",
    "scheduling": {
      "type": "scheduled",
      "interval": "daily",
      "time": "09:00",
      "timezone": "America/Los_Angeles"
    },

    "modules": [
      {
        "id": 1,
        "type": "http",
        "name": "1. Query ERPNext for Stale HD Tickets (> 48 h)",
        "config": {
          "method": "GET",
          "url": "{{env.ERPNEXT_BASE_URL}}/api/resource/HD%20Ticket",
          "headers": [
            { "name": "Authorization", "value": "token {{env.ERPNEXT_API_KEY}}:{{env.ERPNEXT_API_SECRET}}" },
            { "name": "Accept",        "value": "application/json" }
          ],
          "queryParams": [
            {
              "name": "filters",
              "value": "[[\"status\",\"in\",[\"Open\",\"Replied\"]],[\"creation\",\"<\",\"{{formatDate(addHours(now; -48); 'YYYY-MM-DD HH:mm:ss')}}\"]]"
            },
            {
              "name": "fields",
              "value": "[\"name\",\"subject\",\"status\",\"priority\",\"customer_name\",\"custom_unit\",\"custom_property\",\"creation\"]"
            },
            { "name": "limit_page_length", "value": "500" },
            { "name": "order_by",          "value": "creation asc" }
          ],
          "parseResponse": true
        },
        "next": 2
      },

      {
        "id": 2,
        "type": "router",
        "name": "2. Check if Any Stale Tickets Exist",
        "routes": [
          {
            "label": "Stale tickets found",
            "condition": {
              "field": "{{length(1.data)}}",
              "operator": "greater-than",
              "value": "0"
            },
            "next": 3
          },
          {
            "label": "No stale tickets – stop",
            "condition": null,
            "next": null
          }
        ]
      },

      {
        "id": 3,
        "type": "text-aggregator",
        "name": "3. Build Ticket Summary Text",
        "config": {
          "sourceModule": 1,
          "rowSeparator": "\\n\\n",
          "text": "• *Ticket {{item.name}}* – Unit {{item.custom_unit}}\n  Issue: {{item.subject}}\n  Tenant: {{item.customer_name}}\n  Priority: {{item.priority}}\n  Open for: {{round(dateDiff(parseDate(item.creation; 'YYYY-MM-DD HH:mm:ss'); now; 'hours'))}} hours\n  Status: {{item.status}}"
        },
        "next": 4
      },

      {
        "id": 4,
        "type": "telegram-bot",
        "name": "4. Send Stale-Ticket Alert to Landlord",
        "config": {
          "connection": "Telegram Bot – Landlord Channel",
          "chatId": "{{env.TELEGRAM_LANDLORD_CHAT_ID}}",
          "parseMode": "Markdown",
          "text": "⚠️ *Stale Maintenance Tickets*\n\n{{length(1.data)}} work order(s) have been open for more than 48 hours:\n\n{{3.text}}\n\nPlease follow up with the assigned vendors."
        },
        "next": null
      }
    ]
  }
}
