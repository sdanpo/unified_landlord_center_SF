{
  "name": "Stale Maintenance Ticket – Daily Proactive Alert",
  "flow": [
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": false, "useNewZLibDecompression": true },
      "mapper": {
        "url": "YOUR_ERPNEXT_BASE_URL/api/resource/HD%20Ticket",
        "serializeUrl": false,
        "method": "get",
        "headers": [
          { "key": "Authorization", "value": "token YOUR_ERPNEXT_API_KEY:YOUR_ERPNEXT_API_SECRET" },
          { "key": "Accept", "value": "application/json" }
        ],
        "qs": [
          { "key": "filters", "value": "[[\"status\",\"in\",[\"Open\",\"Replied\"]],[\"creation\",\"<\",\"{{formatDate(addHours(now; -48); 'YYYY-MM-DD HH:mm:ss')}}\"]]" },
          { "key": "fields",  "value": "[\"name\",\"subject\",\"status\",\"priority\",\"customer\",\"custom_unit\",\"custom_property\",\"creation\"]" },
          { "key": "limit_page_length", "value": "500" },
          { "key": "order_by", "value": "creation asc" }
        ],
        "bodyType": "",
        "parseResponse": true
      },
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": { "expect": { "method": { "label": "GET" } } }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": { "designer": { "x": 300, "y": 0 } },
      "routes": [
        {
          "label": "Stale tickets found",
          "filter": {
            "name": "Has stale tickets",
            "conditions": [
              [ { "a": "{{length(1.data.message)}}", "b": "0", "o": "greater" } ]
            ]
          },
          "flow": [
            {
              "id": 3,
              "module": "builtin:Iterator",
              "version": 1,
              "parameters": {},
              "mapper": { "array": "{{1.data.message}}" },
              "metadata": { "designer": { "x": 600, "y": -150 } }
            },
            {
              "id": 4,
              "module": "builtin:TextAggregator",
              "version": 1,
              "parameters": { "feeder": 3, "rowSeparator": "\n\n" },
              "mapper": {
                "value": "• *{{3.name}}* – Unit {{3.custom_unit}}\n  Issue: {{3.subject}}\n  Tenant: {{3.customer}}\n  Priority: {{3.priority}}\n  Open for: {{round(dateDiff(parseDate(3.creation; 'YYYY-MM-DD HH:mm:ss'); now; 'hours'))}} hours\n  Status: {{3.status}}"
              },
              "metadata": {
                "designer": { "x": 900, "y": -150 },
                "restore": {
                  "parameters": { "feeder": { "label": "3. Iterator" } }
                }
              }
            },
            {
              "id": 5,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": false, "useNewZLibDecompression": true },
              "mapper": {
                "url": "https://api.telegram.org/botYOUR_TELEGRAM_BOT_TOKEN/sendMessage",
                "serializeUrl": false,
                "method": "post",
                "headers": [ { "key": "Content-Type", "value": "application/json" } ],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "body": "{\"chat_id\":\"YOUR_TELEGRAM_LANDLORD_CHAT_ID\",\"parse_mode\":\"Markdown\",\"text\":\"⚠️ *Stale Maintenance Tickets*\\n\\n{{length(1.data.message)}} work order(s) open for more than 48 hours:\\n\\n{{4.text}}\\n\\nPlease follow up with the assigned vendors.\"}",
                "parseResponse": true
              },
              "metadata": {
                "designer": { "x": 1200, "y": -150 },
                "restore": { "expect": { "method": { "label": "POST" } } }
              }
            }
          ]
        },
        {
          "label": "No stale tickets – stop",
          "flow": []
        }
      ]
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com"
  }
}
