{
  "name": "Weekly Portfolio Report – Friday 17:00",
  "flow": [
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": false, "useNewZLibDecompression": true },
      "mapper": {
        "url": "YOUR_ERPNEXT_BASE_URL/api/resource/GL%20Entry",
        "serializeUrl": false,
        "method": "get",
        "headers": [
          { "key": "Authorization", "value": "token YOUR_ERPNEXT_API_KEY:YOUR_ERPNEXT_API_SECRET" },
          { "key": "Accept", "value": "application/json" }
        ],
        "qs": [
          { "key": "filters", "value": "[[\"posting_date\",\">=\",\"{{formatDate(addDays(now; -6); 'YYYY-MM-DD')}}\"], [\"posting_date\",\"<=\",\"{{formatDate(now; 'YYYY-MM-DD')}}\"]]" },
          { "key": "fields",  "value": "[\"name\",\"account\",\"debit\",\"credit\",\"voucher_type\",\"posting_date\",\"remarks\"]" },
          { "key": "limit_page_length", "value": "500" }
        ],
        "bodyType": "",
        "parseResponse": true
      },
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": { "expect": { "method": { "label": "GET" } } }
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": false, "useNewZLibDecompression": true },
      "mapper": {
        "url": "YOUR_ERPNEXT_BASE_URL/api/resource/Sales%20Invoice",
        "serializeUrl": false,
        "method": "get",
        "headers": [
          { "key": "Authorization", "value": "token YOUR_ERPNEXT_API_KEY:YOUR_ERPNEXT_API_SECRET" },
          { "key": "Accept", "value": "application/json" }
        ],
        "qs": [
          { "key": "filters", "value": "[[\"docstatus\",\"=\",1],[\"outstanding_amount\",\">\",0]]" },
          { "key": "fields",  "value": "[\"name\",\"customer_name\",\"outstanding_amount\",\"due_date\",\"custom_unit\"]" },
          { "key": "limit_page_length", "value": "500" }
        ],
        "bodyType": "",
        "parseResponse": true
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "restore": { "expect": { "method": { "label": "GET" } } }
      }
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": false, "useNewZLibDecompression": true },
      "mapper": {
        "url": "YOUR_ERPNEXT_BASE_URL/api/resource/Issue",
        "serializeUrl": false,
        "method": "get",
        "headers": [
          { "key": "Authorization", "value": "token YOUR_ERPNEXT_API_KEY:YOUR_ERPNEXT_API_SECRET" },
          { "key": "Accept", "value": "application/json" }
        ],
        "qs": [
          { "key": "filters", "value": "[[\"status\",\"in\",[\"Open\",\"Replied\"]]]" },
          { "key": "fields",  "value": "[\"name\",\"subject\",\"status\",\"priority\",\"custom_unit\"]" },
          { "key": "limit_page_length", "value": "500" }
        ],
        "bodyType": "",
        "parseResponse": true
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 },
        "restore": { "expect": { "method": { "label": "GET" } } }
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": false, "useNewZLibDecompression": true },
      "mapper": {
        "url": "YOUR_ERPNEXT_BASE_URL/api/resource/Lease",
        "serializeUrl": false,
        "method": "get",
        "headers": [
          { "key": "Authorization", "value": "token YOUR_ERPNEXT_API_KEY:YOUR_ERPNEXT_API_SECRET" },
          { "key": "Accept", "value": "application/json" }
        ],
        "qs": [
          { "key": "filters", "value": "[[\"lease_status\",\"=\",\"Active\"],[\"end_date\",\"<\",\"{{formatDate(addDays(now; 60); 'YYYY-MM-DD')}}\"]]" },
          { "key": "fields",  "value": "[\"name\",\"tenant_name\",\"property_unit\",\"end_date\",\"monthly_rent\"]" },
          { "key": "limit_page_length", "value": "500" }
        ],
        "bodyType": "",
        "parseResponse": true
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 },
        "restore": { "expect": { "method": { "label": "GET" } } }
      }
    },
    {
      "id": 5,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": false, "useNewZLibDecompression": true },
      "mapper": {
        "url": "https://api.telegram.org/botYOUR_TELEGRAM_BOT_TOKEN/sendMessage",
        "serializeUrl": false,
        "method": "post",
        "headers": [ { "key": "Content-Type", "value": "application/json" } ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "body": "{\"chat_id\":\"YOUR_TELEGRAM_LANDLORD_CHAT_ID\",\"parse_mode\":\"Markdown\",\"text\":\"📊 *Weekly Portfolio Report*\\n📅 Week ending {{formatDate(now; 'MMMM D, YYYY')}}\\n\\n💰 *Financials (GL Entries)*\\n• Total Credits: ${{formatNumber(sum(map(1.data.message; 'credit')); 2; '.'; ',')}}\\n• Total Debits: ${{formatNumber(sum(map(1.data.message; 'debit')); 2; '.'; ',')}}\\n• Net: ${{formatNumber(subtract(sum(map(1.data.message; 'credit')); sum(map(1.data.message; 'debit'))); 2; '.'; ',')}}\\n\\n🚨 *Delinquencies*\\n• {{length(2.data.message)}} invoice(s) outstanding\\n• Total outstanding: ${{formatNumber(sum(map(2.data.message; 'outstanding_amount')); 2; '.'; ',')}}\\n\\n🔧 *Maintenance*\\n• {{length(3.data.message)}} open work order(s)\\n\\n📋 *Leases Expiring (60 days)*\\n• {{length(4.data.message)}} lease(s) requiring attention\\n\\n_Report generated automatically by Unified Landlord Center._\"}",
        "parseResponse": true
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0 },
        "restore": { "expect": { "method": { "label": "POST" } } }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com"
  }
}
